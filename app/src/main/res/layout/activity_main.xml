<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blur_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/roster_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout1"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/epochSpinner"
                        android:inputType="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/textInputLayout1"
                    android:layout_marginHorizontal="10dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/versionSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageView
                    android:id="@+id/refreshBtn"
                    app:tint="?attr/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/textInputLayout1"
                    app:layout_constraintStart_toEndOf="@id/textInputLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:tooltipText="Проверить обновления"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@android:drawable/ic_popup_sync" />

                <com.google.android.material.search.SearchBar
                    android:id="@+id/search_bar"
                    style="@style/Widget.Material3.SearchBar.Outlined"
                    android:transitionName="search_transition"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    app:layout_constraintTop_toBottomOf="@id/textInputLayout1"
                    app:layout_constraintStart_toStartOf="@id/textInputLayout1"
                    app:layout_constraintEnd_toEndOf="@id/refreshBtn"
                    android:layout_marginTop="10dp"
                    android:hint="@string/search_label"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp"
                    app:defaultMarginsEnabled="false"
                    app:navigationIcon="@drawable/search_24px"
                    app:strokeColor="?colorSurfaceContainerHighest"
                    app:strokeWidth="1dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/statusTextView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="italic"
                android:layout_marginTop="10dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/roster_controls"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.example.nbarandomizer.ui.components.BlurredNavigationLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="@dimen/bottom_navigation_width"
            android:layout_height="@dimen/bottom_navigation_height"
            android:layout_marginBottom="@dimen/bottom_navigation_bottom_margin"
            android:background="@drawable/bottom_navigation_background"
            android:clipChildren="false"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.example.nbarandomizer.ui.components.DropNavigationIndicatorView
                android:id="@+id/bottom_navigation_indicator"
                android:layout_width="@dimen/bottom_navigation_item_size"
                android:layout_height="@dimen/bottom_navigation_item_size"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/bottom_navigation_items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tournament_navigation"
                android:layout_width="@dimen/bottom_navigation_item_size"
                android:layout_height="@dimen/bottom_navigation_item_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/navigation_tournament"
                android:padding="12dp"
                android:tooltipText="@string/navigation_tournament"
                app:srcCompat="@drawable/emoji_events_24px"
                android:defaultFocusHighlightEnabled="false"
                app:tint="@color/bottom_navigation_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/randomizer_navigation"
                android:layout_width="@dimen/bottom_navigation_item_size"
                android:layout_height="@dimen/bottom_navigation_item_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/navigation_randomizer"
                android:padding="12dp"
                android:tooltipText="@string/navigation_randomizer"
                app:srcCompat="@drawable/dices_24px"
                android:defaultFocusHighlightEnabled="false"
                app:tint="@color/bottom_navigation_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/roster_navigation"
                android:layout_width="@dimen/bottom_navigation_item_size"
                android:layout_height="@dimen/bottom_navigation_item_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/navigation_roster"
                android:padding="12dp"
                android:tooltipText="@string/navigation_roster"
                app:srcCompat="@drawable/sports_basketball_24px"
                android:defaultFocusHighlightEnabled="false"
                app:tint="@color/bottom_navigation_icon_tint" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settings_navigation"
                android:layout_width="@dimen/bottom_navigation_item_size"
                android:layout_height="@dimen/bottom_navigation_item_size"
                android:background="@android:color/transparent"
                android:contentDescription="@string/navigation_settings"
                android:padding="12dp"
                android:tooltipText="@string/navigation_settings"
                app:srcCompat="@drawable/settings_24px"
                android:defaultFocusHighlightEnabled="false"
                app:tint="@color/bottom_navigation_icon_tint" />
            </LinearLayout>
        </com.example.nbarandomizer.ui.components.BlurredNavigationLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
