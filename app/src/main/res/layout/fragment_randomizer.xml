<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.randomizer.RandomizerFragment">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/randomizeButton"
        android:transitionName="my_transition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="10dp"
        android:tint="@color/white"
        android:src="@drawable/randomize_icon"
        app:maxImageSize="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card1"
        style="@style/BackGroundCard"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card2">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/twoTeamsText"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                app:layout_constraintBottom_toBottomOf="@+id/twoTeamsSwitch"
                app:layout_constraintEnd_toStartOf="@+id/twoTeamsSwitch"
                app:layout_constraintStart_toStartOf="@+id/playersCountSeekBar"
                app:layout_constraintTop_toTopOf="@+id/twoTeamsSwitch" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/twoTeamsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/playersCountTextView"
                app:layout_constraintEnd_toEndOf="@+id/playersCountSeekBar" />

            <com.google.android.material.divider.MaterialDivider
                style="@style/Divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/twoTeamsSwitch"
                app:layout_constraintBottom_toTopOf="@id/playersCountTextView" />

            <TextView
                android:id="@+id/playersCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/players_count_text_view_initial_value"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                app:layout_constraintBottom_toTopOf="@+id/playersCountSeekBar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <SeekBar
                style="@android:style/Widget.Material.SeekBar.Discrete"
                android:id="@+id/playersCountSeekBar"
                android:thumbTint="?attr/colorPrimary"
                android:progressTint="?attr/colorPrimary"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:max="4"
                android:min="0"
                android:progress="0"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card2"
        style="@style/BackGroundCard"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/history_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:text="@string/positionsTitle"
                android:textSize="20sp"
                android:textStyle="bold|italic"
                app:layout_constraintBottom_toTopOf="@id/positionsChips" />

            <com.google.android.material.divider.MaterialDivider
                style="@style/Divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView"
                app:layout_constraintBottom_toTopOf="@id/positionsChips" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/positionsChips"
                app:singleSelection="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/history_card"
        android:transitionName="history_transition"
        style="@style/BackGroundCard"
        android:clickable="true"
        android:stateListAnimator="@animator/button_animation"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/randomizeButton">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="5dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/history_fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:elevation="2dp"
                android:clickable="false"
                app:fabCustomSize="40dp"
                app:maxImageSize="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/remainingPlayersTextView"
                app:layout_constraintBottom_toBottomOf="@id/show_history_label"
                android:src="@drawable/history_24px" />

            <TextView
                android:id="@+id/remainingPlayersTextView"
                app:layout_constraintStart_toEndOf="@id/history_fab"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/show_history_label"
                android:text="@string/show_history_label"
                app:layout_constraintStart_toStartOf="@id/remainingPlayersTextView"
                app:layout_constraintTop_toBottomOf="@id/remainingPlayersTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="italic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/resetBtnText"
                android:stateListAnimator="@animator/button_animation"
                android:textSize="20sp"
                android:textStyle="italic"
                app:layout_constraintTop_toBottomOf="@id/show_history_label"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
