<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:paddingTop="10dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/photo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="40dp"
        android:backgroundTint="@color/gray"
        app:strokeColor="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo"
            android:layout_width="80dp"
            android:layout_height="80dp"/>
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/refreshBtn"
        app:tint="?attr/colorPrimary"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:tooltipText="Заменить игрока"
        app:layout_constraintEnd_toEndOf="@+id/name"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_popup_sync" />

    <include
        android:id="@+id/name"
        layout="@layout/view_player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photo_container" />

    <include
        android:id="@+id/details"
        layout="@layout/view_player_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@id/name"
        app:layout_constraintStart_toStartOf="@id/name"
        app:layout_constraintTop_toBottomOf="@id/name" />

    <com.example.nbarandomizer.ui.components.RatingView
        android:id="@+id/overallCardView"
        style="@style/ratingCard"
        android:layout_marginHorizontal="10dp"
        android:tooltipText="Overall"
        app:layout_constraintBottom_toBottomOf="@+id/threePtCardView"
        app:layout_constraintEnd_toStartOf="@+id/threePtCardView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/threePtCardView" />


    <com.example.nbarandomizer.ui.components.RatingView
        android:id="@+id/threePtCardView"
        style="@style/ratingCard"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="10dp"
        android:tooltipText="3pt"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/details" />

    <com.example.nbarandomizer.ui.components.RatingView
        android:id="@+id/dunkCardView"
        style="@style/ratingCard"
        android:layout_marginHorizontal="10dp"
        android:tooltipText="Driving dunk"
        app:layout_constraintBottom_toBottomOf="@+id/threePtCardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/threePtCardView"
        app:layout_constraintTop_toTopOf="@+id/threePtCardView" />
</androidx.constraintlayout.widget.ConstraintLayout>
